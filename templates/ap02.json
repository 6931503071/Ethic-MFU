{
  "id": "ap02_research_proposal",
  "name": "AP 02/2026 Research Proposal Form",
  "submit_to": "https://submission-ec.mfu.ac.th",
  "language": ["en", "th"],
  "note": "ร่างโครง: หัวข้อใน sections เป็นตัวอย่างชั่วคราว ให้แทนด้วยหัวข้อจริงจากฟอร์ม AP 02/2026 ฉบับทางการ",

  "format": {
    "page_size": "A4",
    "margins_mm": { "top": 25, "bottom": 25, "left": 25, "right": 25 },
    "font_family": "TH Sarabun New",
    "body_size_pt": 16,
    "heading_size_pt": 18,
    "page_numbers": true,
    "output": "pdf_saved_from_word",
    "digital_signature": false
  },

  "rules": {
    "highlight_color": "red",
    "highlight_targets": ["placeholder", "typo", "ambiguous", "incomplete"],
    "check_spacing_and_punctuation": true,
    "check_thai_spelling": true,
    "personal_data_filled_by": "user"
  },

  "attachments": [
    {
      "id": "thai_summary",
      "title": "บทสรุปย่อภาษาไทย",
      "required": true
    }
  ],

  "sections": [
    {
      "id": "general_info",
      "title": "General information",
      "fields": [
        { "id": "project_title_th", "label": "ชื่อโครงการ (ไทย)", "fill_by": "ai" },
        { "id": "project_title_en", "label": "Project title (English)", "fill_by": "ai" },
        { "id": "researcher_name", "label": "ชื่อผู้วิจัย", "fill_by": "user" },
        { "id": "affiliation", "label": "สังกัด", "fill_by": "user" },
        { "id": "contact", "label": "ข้อมูลติดต่อ", "fill_by": "user" },
        { "id": "submission_date", "label": "วันที่", "fill_by": "user" }
      ]
    },
    {
      "id": "background",
      "title": "Background and rationale",
      "fields": [
        { "id": "background_text", "label": "ความเป็นมาและเหตุผล", "fill_by": "ai" }
      ]
    },
    {
      "id": "objectives",
      "title": "Objectives",
      "fields": [
        { "id": "objectives_text", "label": "วัตถุประสงค์", "fill_by": "ai" }
      ]
    },
    {
      "id": "methodology",
      "title": "Methodology",
      "fields": [
        { "id": "methodology_text", "label": "ระเบียบวิธีวิจัย", "fill_by": "ai" }
      ]
    }
  ]
}
